# Dependencies and package-manager caches
**/node_modules/
**/bower_components/
**/.npm/
**/.yarn/cache/
**/.pnpm-store/

# Compiled output and build caches
**/dist/
**/build/
**/out/
**/coverage/
**/.next/
**/.nuxt/
**/.output/
**/.turbo/
**/.vite/
**/.cache/
**/*.tsbuildinfo

# Local environment files and secrets
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/*credentials*.json
**/*service-account*.json

# Logs, temporary files, and crash reports
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/*.pid
**/*.pid.lock
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
**/tmp/
**/temp/
**/*.tmp
**/*.swp
**/*.swo
**/*~

# Local databases, dumps, and service data
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.bak
**/*.backup
**/*.sql.gz
**/pgdata/
**/redis-data/
**/prometheus-data/
**/grafana-data/
**/.data/

# Test-run artifacts
**/test-results/
**/playwright-report/
**/cypress/videos/
**/cypress/screenshots/

# Editor and operating-system files
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
**/.idea/
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
