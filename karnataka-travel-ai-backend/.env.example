# Copy to .env, then run: docker compose up --build
# ---- required secrets (generate with: openssl rand -hex 32) ----
INTERNAL_API_KEY=change-me-internal-key-32-chars-min
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-x

# ---- local infra passwords (dev only) ----
POSTGRES_PASSWORD=postgres
GRAFANA_PASSWORD=admin

# ---- Redis (leave blank for the local Compose Redis; Upstash should use rediss://) ----
REDIS_URL=

# ---- Kafka (local Compose uses Redpanda; managed brokers can use TLS + SASL) ----
KAFKA_BROKER=
KAFKA_BROKERS=
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CA_CERT_BASE64=

# ---- gateway / cookies ----
CORS_ORIGIN=http://localhost:5173,https://kannada-digital-innovation.vercel.app,https://kannada-digital-innovation-yrqz.vercel.app
COOKIE_SECURE=false

# ---- optional: seeded admin (needed to call /alerts/check-status and /alerts/dispatch-notification) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# ---- AI: leave blank to run in offline/demo mode (template itineraries, hashed embeddings) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- voice (optional) ----
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
GOOGLE_TTS_API_KEY=

# ---- notifications (optional; otherwise dry-run logs) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Karnataka Travel AI <alerts@example.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- demo helpers ----
ENABLE_DEMO_ENDPOINTS=true
OTEL_ENABLED=true
LOG_LEVEL=info
