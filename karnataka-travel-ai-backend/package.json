{
  "name": "karnataka-travel-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Karnataka Travel & Cultural Experience Platform - backend microservices, workers and shared packages",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @kta/logger && npm run build -w @kta/shared-types && npm run build -w @kta/kafka-events && npm run build -w @kta/service-kit",
    "build:apps": "npm run build -w @kta/api-gateway -w @kta/auth-service -w @kta/user-service -w @kta/itinerary-service -w @kta/alert-service -w @kta/reroute-service -w @kta/language-culture-service -w @kta/admin-service -w @kta/ai-itinerary-worker -w @kta/gis-transit-worker",
    "build": "turbo run build",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "start:all": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"GATEWAY,AUTH,USER\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"node --max-old-space-size=80 services/api-gateway/dist/index.js\" \"node --max-old-space-size=80 services/auth-service/dist/index.js\" \"node --max-old-space-size=80 services/user-service/dist/index.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "concurrently": "^10.0.6"
  }
}
